# ==============================================================================
# VERIFIED LABOUR - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# IMPORTANT: Never commit your actual .env file or real production secrets to git!
# ==============================================================================

# Application Port & URLs
# NOTE: Verified Labour runs on port 3001 to avoid conflicts with other apps (e.g. EduConnects on port 3000)
PORT=3001
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Database Configuration
# Local SQLite development:
DATABASE_URL="file:./dev.db"
# Production PostgreSQL (uncomment and configure for VPS production):
# DATABASE_URL="postgresql://postgres:your_secure_password@localhost:5432/verifiedlabour?schema=public"

# Authentication & Security
# Generate a cryptographically secure 64-character random string (e.g. `openssl rand -base64 48`)
JWT_SECRET="replace-with-a-very-long-and-secure-random-jwt-secret-minimum-32-chars"

# Cashfree Secure ID Credentials (Aadhaar & Bank Account Verification)
# Environment: 'sandbox' for staging/testing, 'production' for live verification
CASHFREE_ENVIRONMENT="sandbox"
CASHFREE_CLIENT_ID="TEST_CF_CLIENT_ID_PLACEHOLDER"
CASHFREE_CLIENT_SECRET="TEST_CF_CLIENT_SECRET_PLACEHOLDER"
CASHFREE_API_VERSION="2022-09-01"

# Razorpay Credentials (Payments, Bookings & Subscriptions)
RAZORPAY_KEY_ID="rzp_test_placeholderKey123"
RAZORPAY_KEY_SECRET="rzp_secret_placeholderKeySecret456"
RAZORPAY_WEBHOOK_SECRET="whsec_placeholder789"

# Geocoding & Maps Provider (MapTiler or OpenStreetMap Nominatim)
MAPS_API_KEY="maps_placeholder_or_osm_nominatim"

# Storage Credentials (Local or AWS S3 Compatible)
STORAGE_PROVIDER="local" # 'local' or 's3'
STORAGE_BUCKET="verified-labour-docs"
STORAGE_REGION="ap-south-1"
STORAGE_ACCESS_KEY_ID="storage_access_key_placeholder"
STORAGE_SECRET_ACCESS_KEY="storage_secret_key_placeholder"

# Notification Providers (SMS & Email OTPs)
SMS_PROVIDER="mock" # 'mock' for sandbox development, or 'msg91' / 'twilio' for production
SMS_API_KEY="sms_api_key_placeholder"
EMAIL_FROM="noreply@verifiedlabour.com"
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="2525"
SMTP_USER="smtp_user_placeholder"
SMTP_PASS="smtp_pass_placeholder"
